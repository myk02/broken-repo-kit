+class CouponError(ValueError):
+    """Base class for every coupon problem."""
+
+
+class UnknownCoupon(CouponError):
+    """Raised when a code is not in the coupon book."""
+
+    def __init__(self, code: object) -> None:
+        super().__init__(f"unknown coupon: {code!r}")
+        self.code = code
+
+
+class ExpiredCoupon(CouponError):
+    """Raised when a coupon's last valid tick has passed."""
+
+    def __init__(self, code: str, expires_on: int, now: int) -> None:
+        super().__init__(f"coupon {code!r} expired after tick {expires_on} (now {now})")
+        self.code = code
+        self.expires_on = expires_on
+        self.now = now
+
+
+class CouponMinimumNotMet(CouponError):
+    """Raised when the basket is below the coupon's minimum spend."""
+
+    def __init__(self, code: str, required_cents: Cents, actual_cents: Cents) -> None:
+        super().__init__(
+            f"coupon {code!r} needs a subtotal of at least {required_cents} cents, "
+            f"but the basket is {actual_cents}"
+        )
+        self.code = code
+        self.required_cents = required_cents
+        self.actual_cents = actual_cents
+
+
+@dataclass(frozen=True)
+class Coupon:
+    """A percentage or fixed-amount coupon with a minimum spend and expiry.
+
+    ``expires_on`` is the last clock tick on which the coupon is valid
+    (inclusive); ``None`` means it never expires. Codes are compared
+    case-insensitively after trimming surrounding whitespace.
+    """
+
+    code: str
+    percent: int | None = None
+    fixed_cents: Cents | None = None
+    min_spend_cents: Cents = 0
+    expires_on: int | None = None
+
+    def __post_init__(self) -> None:
+        cleaned = self.code.strip()
+        if not cleaned:
+            raise ValueError("coupon code must not be blank")
+        object.__setattr__(self, "code", cleaned)
+        if (self.percent is None) == (self.fixed_cents is None):
+            raise ValueError("a coupon needs exactly one of percent or fixed_cents")
+        if self.percent is not None and not 1 <= self.percent <= 100:
+            raise ValueError("coupon percent must be between 1 and 100")
+        if self.fixed_cents is not None and self.fixed_cents < 1:
+            raise ValueError("coupon fixed_cents must be at least 1")
+        if self.min_spend_cents < 0:
+            raise ValueError("coupon min_spend_cents must not be negative")
+        if self.expires_on is not None and not isinstance(self.expires_on, int):
+            raise TypeError("coupon expires_on must be an integer tick or None")
+
+    def apply_to(self, amount_cents: Cents) -> Cents:
+        """Return the amount that remains after this coupon."""
+        if amount_cents < 0:
+            raise ValueError("cannot discount a negative amount")
+        if self.percent is not None:
+            taken = round_half_up(amount_cents * self.percent, 100)
+        else:
+            assert self.fixed_cents is not None
+            taken = self.fixed_cents
+        return amount_cents - min(amount_cents, taken)
+
+
+class CouponBook:
+    """A set of coupons with one injected clock for every expiry decision."""
+
+    def __init__(self, coupons: Iterable[Coupon], *, clock: Callable[[], int]) -> None:
+        if not callable(clock):
+            raise TypeError("clock must be callable")
+        self._clock = clock
+        self._coupons: dict[str, Coupon] = {}
+        for coupon in coupons:
+            if not isinstance(coupon, Coupon):
+                raise TypeError("coupons must be Coupon instances")
+            key = self._key(coupon.code)
+            if key in self._coupons:
+                raise ValueError(f"duplicate coupon code: {coupon.code!r}")
+            self._coupons[key] = coupon
+
+    @staticmethod
+    def _key(code: str) -> str:
+        return code.strip().casefold()
+
+    def __len__(self) -> int:
+        return len(self._coupons)
+
+    def resolve(self, code: str, *, subtotal_cents: Cents) -> Coupon:
+        """Return the coupon for ``code`` or raise a :class:`CouponError`."""
+        if not isinstance(code, str):
+            raise CouponError("one coupon per order; the code must be a string")
+        coupon = self._lookup(code)
+        self._check_expiry(coupon)
+        self._check_minimum(coupon, subtotal_cents)
+        return coupon
+
+    def _lookup(self, code: str) -> Coupon:
+        try:
+            return self._coupons[self._key(code)]
+        except KeyError:
+            raise UnknownCoupon(code) from None
+
+    def _check_expiry(self, coupon: Coupon) -> None:
+        now = self._clock()
+        if coupon.expires_on is not None and now > coupon.expires_on:
+            raise ExpiredCoupon(coupon.code, coupon.expires_on, now)
+
+    def _check_minimum(self, coupon: Coupon, subtotal_cents: Cents) -> None:
+        if subtotal_cents < coupon.min_spend_cents:
+            raise CouponMinimumNotMet(coupon.code, coupon.min_spend_cents, subtotal_cents)
+
+
